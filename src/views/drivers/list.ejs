<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head', { page_title: 'Motoristas' }) %>

<body>
  <%- include('../partials/header', { tab: 'motoristas' }) %>

  <div class="inner-body">

    <% if (drivers.length === 0) { %>
    <p>Nenhum motorista encontrada.</p>
    <% } else { %>
    <div class="table">
      <div class="table-header table-row">
        <div class="table-cell">Status</div>
        <div class="table-cell">Nome</div>
      </div>

      <div class="table-body">

        <%  drivers.forEach((driver) => { %>
        <a href="/motoristas/<%= driver.id %>" class="table-row">
          <div class="table-cell"><%= driver.status %></div>
          <div class="table-cell"><%= driver.nome %></div>
        </a>
        <% });%>
      </div>

      <div class="table-footer table-row">
        <a class="table-cell add" href="/motoristas/novo">
          <img src="/svg/plus.svg" alt="Criar novo motorista" />
        </a>
      </div>
    </div>
    <% }%>

  </div>
</body>

</html>