<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head', { page_title: 'Motoristas' }) %>

<body>
  <%- include('../partials/header', { tab: 'motoristas' }) %>

  <p></p>

  <% if (drivers.length === 0) { %>
  <p>Nenhum motorista encontrada.</p>
  <% } else { %>
  <div class="table-container">
    <table>
      <tr class="table-header">
        <th>Status</th>
        <th>Nome</th>
      </tr>
      <%  drivers.forEach((driver) => { %>
      <tr>
        <td><a href="/motoristas/<%= driver.id %>"><%= driver.status %></a></td>
        <td><a href="/motoristas/<%= driver.id %>"><%= driver.nome %></a></td>
      </tr>
      <% });%>

      <tr>
        <td colspan="2">
          <a class="tile add" href="/motoristas/novo">
            <img src="/svg/plus.svg" alt="Criar novo motorista" />
          </a>
        </td>
      </tr>
    </table>
  </div>
  <% }%>

</body>

</html>