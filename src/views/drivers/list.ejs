<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head', { page_title: 'Motoristas' }) %>

<body>
  <%- include('../partials/header', { tab: 'motoristas' }) %>

  <% if (drivers.length === 0) { %>
  <p>Nenhum motorista encontrada.</p>
  <% } else { %>
  <div class="three-grid">
    <%  drivers.forEach((driver) => { %>
    <a class="tile" href="/motoristas/<%= driver.id %>">
      <%- include('../partials/driver', { driver: driver }) %>
    </a>
    <% });} %>
    <%- include('../partials/new') %>
  </div>

</body>

</html>