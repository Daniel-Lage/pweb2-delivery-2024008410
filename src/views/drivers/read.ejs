<!DOCTYPE html>
<html lang="en">

<%- include('../partials/head', { page_title: 'Motorista' }) %>

<body>
  <%- include('../partials/header', { tab: 'motoristas' }) %>

  <div class="inner-header">
    <%- include('../partials/driver', { driver: driver }) %>
  </div>

  <div class="inner-body">
    <strong>CPF</strong>
    <p><%= driver.cpf %></p>

    <strong>Placa do Veiculo</strong>
    <p><%= driver.placaVeiculo || '--' %></p>

    <strong>Entregas</strong>
    <% if (deliveries.length === 0) { %>
    <p>Nenhuma entrega encontrada.</p>
    <% } else { %>
    <div class="three-grid">
      <%  deliveries.forEach((delivery) => { %>
      <a class="tile" href="/entregas/<%= delivery.id %>">
        <%- include('../partials/delivery', { delivery: delivery }) %>
      </a>
      <% }); %>
    </div>
    <% } %>

</body>

</html>