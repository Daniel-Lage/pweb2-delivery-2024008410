<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Delivery Tracker - Motoristas</title>
</head>

<body>
  <h1>Motoristas</h1>
  <a href="/motoristas"> Voltar para a lista de motoristas</a>

  <table>
    <thead>
      <tr>
        <th>Nome</th>
        <th>CPF</th>
        <th>Status</th>
        <th>Placa</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>
          <%= driver.nome %>
        </td>
        <td>
          <%= driver.cpf %>
        </td>
        <td>
          <%= driver.status %>
        </td>
        <td>
          <%= driver.placaVeiculo ? driver.placaVeiculo : '--' %>
        </td>
        <td>
          <a href="/motoristas/<%= driver.id %>">Ver
            Detalhes</a>
        </td>
      </tr>
    </tbody>
  </table>


  <h2>Entregas do Motorista</h2>
  <% if (deliveries.length === 0) { %>
  <p>Nenhuma entrega encontrada.</p>
  <% } else { %>
  <table>
    <thead>
      <tr>
        <th>Origem</th>
        <th>Destino</th>
        <th>Status</th>
      </tr>
    </thead>
    <tbody>
      <% deliveries.forEach((delivery) => { %>
      <tr>
        <td>
          <%= delivery.origem %>
        </td>
        <td>
          <%= delivery.destino %>
        </td>
        <td>
          <%= delivery.status %>
        </td>
        <td>
          <a href="/entregas/<%= delivery.id %>">Ver
            Detalhes</a>
        </td>
      </tr>
      <% }); %>
    </tbody>
  </table>
  <% } %>
</body>

</html>