<!DOCTYPE html>
<html lang="en">

<%- include('../partials/head', { page_title: 'Entrega' }) %>

<body>
  <%- include('../partials/header', { tab: 'entregas' }) %>

  <div class="inner-header">
    <%- include('../partials/delivery', { delivery: delivery }) %>
  </div>

  <div class="inner-body">
    <strong>Descrição</strong>
    <%= delivery.descricao %>

    <strong>Motorista</strong>
    <% if (delivery.motoristaId) { %>
    <td>
      <%= drivers.find((d) => d.id === delivery.motoristaId)?.nome %>
    </td>
    <% } else { %>
    <td>
      --
    </td>
    <% } %>

    <strong>Ações</strong>
    <% if (!delivery.motoristaId) { %>
    <form action="/entregas/<%= delivery.id %>/atribuir" method="POST">
      <select id="motoristaId" name="motoristaId" required>
        <% drivers.forEach((driver) => { %>
        <option value="<%= driver.id %>">
          <%= driver.nome %>
        </option>
        <% }); %>
      </select>
      <button type="submit">Atribuir Motorista</button>
    </form>
    <% } %>

    <form action="/entregas/<%= delivery.id %>/avancar" method="POST">
      <button type="submit">Avançar Status</button>
    </form>

    <form action="/entregas/<%= delivery.id %>/cancelar" method="POST">
      <button type="submit">Cancelar Entrega</button>
    </form>

    <strong>Eventos</strong>
    <% if (delivery.historico.length === 0) { %>
    <p>Nenhum evento de entrega encontrada.</p>
    <% } else { %>
    <div>
      <% delivery.historico.forEach((event) => { %>
      <div>
        <%= event.descricao %>
        <%= event.data.substring(0, 10) %>
      </div>
      <% }); %>
    </div>
    <% } %>
  </div>
</body>

</html>