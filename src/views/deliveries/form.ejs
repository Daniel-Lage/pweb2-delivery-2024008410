<!DOCTYPE html>
<html lang="en">

<%- include('../partials/head', { page_title: 'Nova Entrega' }) %>

<body>
  <%- include('../partials/header', { tab: 'entregas' }) %>

  <div class="inner-body">
    <form action="/entregas" method="POST" class="create-form">
      <label class="label" for="descricao">Descrição</label>
      <input class="input" type="text" id="descricao" name="descricao" required />
      <label class="label" for="origem">Origem</label>
      <input class="input" type="text" id="origem" name="origem" required />
      <label class="label" for="destino">Destino</label>
      <input class="input" type="text" id="destino" name="destino" required />
      <button class="button" type="submit">Criar Entrega</button>
    </form>
  </div>
</body>

</html>